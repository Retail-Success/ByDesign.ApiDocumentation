meta {
  name: Verify Seamless Auth Token for Customer
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v2/authentication/seamless/verify/forcustomer/:guid
  body: none
  auth: inherit
}

params:path {
  guid: 
}

docs {
  `GET /api/v2/authentication/seamless/verify/forcustomer/{guid}`

  Exchange a one-time seamless-login token (the guid) for the customer's identity and an access token; each guid can be used once.

  Required scope: `api/Read`

  Fill in the path parameters on the **Params** tab before sending.
}
